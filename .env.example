# Copy to .env at repo root AND apps/web/.env.local
# Do not commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_PUBLIC_URL=http://localhost:3000

# Direct Postgres connection (Supabase project settings → Database →
# Connection string → URI, service-role equivalent). Used only by
# createPostgresRedeemAdapter (packages/shared) for hub sync-push replay
# and any cloud-direct redeem path — supabase-js/PostgREST cannot run
# that adapter's parameterised SQL.
DATABASE_URL=

# 32-byte AES-256-GCM platform key, base64-encoded. Encrypts/decrypts
# tickets.totp_secret_enc (paystack-webhook, live-ticket-session,
# sync-pull). Generate with: openssl rand -base64 32
PLATFORM_AES_KEY_B64=

# Paystack dashboard → Settings → API Keys & Webhooks → Test Secret Key.
# Used to verify x-paystack-signature on incoming webhooks, and by
# scripts/verify-day2.ts to sign a realistic test payload the same way
# Paystack does.
PAYSTACK_SECRET=

# Optional — real WhatsApp delivery via Meta's Cloud API. Leave unset to
# keep apps/web/src/app/api/process-deliveries in stub mode.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Bootstrap / verify (Section 12 Day 1)
DAY1_MANAGER_EMAIL=manager@memories.test
DAY1_MANAGER_PASSWORD=
DAY1_TEST_MANAGER_EMAIL=manager@testvenue.test
DAY1_TEST_MANAGER_PASSWORD=

# From scripts/bootstrap-day1.ts output
HUB_DEVICE_ID=
HUB_API_KEY=
HUB_PORT=8787
